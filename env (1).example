# Пример настроек. Скопируй этот файл в .env и впиши свои значения.
# Файл .env в GitHub НЕ попадает (он в .gitignore).
# Если хостинг умеет задавать переменные окружения в панели —
# .env не нужен, впиши то же самое там.

# api_id и api_hash аккаунта — https://my.telegram.org  (раздел API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Токен бота-панели от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram ID (узнать можно у @userinfobot). Несколько — через запятую: 111,222
ADMIN_IDS=123456789

# Необязательно: где хранить базу. На хостинге укажи путь на ПОСТОЯННОМ диске,
# иначе после перезапуска шаблоны и вход в аккаунт пропадут.
# DB_PATH=/data/mailer.db
